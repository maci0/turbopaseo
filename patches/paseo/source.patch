+    for (const key of keys) {
+      if (!entry.regex.test(key)) continue;
+      const propertyPath = `${path}/${escapePointerSegment(key)}`;
+      validateNode(entry.schema, data[key], propertyPath, errors, depth + 1);
+    }
+  }
