+/**
+ * native: Emitter<void> for scriptc, which cannot compile a class instantiated with `void`.
+ * Listeners are called with no argument, so they receive `undefined` as with Emitter<void>.
+ */
+export class VoidEmitter {
+  private _listeners: { fn: () => any, thisArgs: any }[] = [];
+  private _disposed = false;
+  private _event: IEvent<void> | undefined;
+
+  public get event(): IEvent<void> {
+    if (this._event) {
+      return this._event;
+    }
+    this._event = (listener: () => any, thisArgs?: any, disposables?: IDisposable[] | DisposableStore) => {
+      if (this._disposed) {
+        return toDisposable(() => {});
+      }
+
+      const entry = { fn: listener, thisArgs };
+      this._listeners = this._listeners.slice();
+      this._listeners.push(entry);
+
+      const result = toDisposable(() => {
+        const idx = this._listeners.indexOf(entry);
+        if (idx !== -1) {
+          this._listeners = this._listeners.slice();
+          this._listeners.splice(idx, 1);
+        }
+      });
+
+      if (disposables) {
+        if (Array.isArray(disposables)) {
+          disposables.push(result);
+        } else {
+          disposables.add(result);
+        }
+      }
+
+      return result;
+    };
+    return this._event;
+  }
+
+  public fire(): void {
+    if (this._disposed || !this._listeners.length) {
+      return;
+    }
+    if (this._listeners.length === 1) {
+      this._listeners[0].fn.call(this._listeners[0].thisArgs);
+      return;
+    }
+    const listeners = this._listeners;
+    for (let i = 0, len = listeners.length; i < len; ++i) {
+      listeners[i].fn.call(listeners[i].thisArgs);
+    }
+  }
+
+  public dispose(): void {
+    if (this._disposed) {
+      return;
+    }
+    this._disposed = true;
+    this._listeners.length = 0;
+  }
+}
