#!/bin/sh
# tp: install, update and remove a turbopaseo build of Paseo.
# Runs from a turbopaseo checkout; $TP_PREFIX/bin/tp links back to this file.
set -eu

die() { echo "tp: $*" >&2; exit 1; }

self=$(realpath "$0")
root=$(dirname "$self")
while [ ! -f "$root/Makefile" ] || [ ! -d "$root/patches/paseo" ]; do
  [ "$root" = / ] && die "no turbopaseo checkout above $self"
  root=$(dirname "$root")
done
prefix=${TP_PREFIX:-$HOME/.local}
opt=$prefix/opt/turbopaseo
bin=$prefix/bin

usage() {
  cat <<EOF
usage: tp <command>
  install [tarball]  install a dist tarball (default: the newest in $root/dist)
  rebuild            make paseo-deps dist, then install the result
  update             self-update, then rebuild
  self-update        fast-forward this checkout and its submodules
  remove             delete the install and the paseo and tp links (~/.paseo stays)
  status             show what is installed
Installs into \$TP_PREFIX (now $prefix): opt/turbopaseo/<release>, bin/paseo, bin/tp.
EOF
}

# A link in $bin we may replace or delete: missing, or a symlink into $opt or this checkout.
ours() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  [ -L "$1" ] || return 1
  case $(readlink "$1") in "$opt"/* | "$root"/*) return 0 ;; esac
  return 1
}

cmd_install() {
  tarball=${1:-$(ls -t "$root"/dist/paseo-*.tar.gz 2>/dev/null | head -1)}
  [ -n "$tarball" ] || die "no tarball in $root/dist; run: make -C $root dist"
  tarball=$(realpath "$tarball")
  name=$(basename "$tarball" .tar.gz)
  (cd "$(dirname "$tarball")" && sha256sum -c --quiet "$name.tar.gz.sha256") || die "checksum failed: $tarball"
  for l in "$bin/paseo" "$bin/tp"; do ours "$l" || die "$l exists and is not a turbopaseo link; move it away first"; done
  mkdir -p "$opt" "$bin"
  stage=$opt/.stage
  rm -rf "$stage"
  mkdir "$stage"
  tar -xzf "$tarball" -C "$stage"
  [ -x "$stage/$name/paseo" ] || die "$tarball holds no $name/paseo"
  rm -rf "${opt:?}/$name"
  mv "$stage/$name" "$opt/$name"
  rmdir "$stage"
  ln -sfn "$name" "$opt/current"
  ln -sfn "$opt/current/paseo" "$bin/paseo"
  ln -sfn "$self" "$bin/tp"
  for d in "$opt"/paseo-*; do [ "$d" = "$opt/$name" ] || rm -rf "$d"; done
  echo "installed $name in $opt"
  "$bin/paseo" --version
  echo "a running daemon keeps the old binary until: paseo daemon restart"
}

cmd_rebuild() {
  make -C "$root" paseo-deps dist
  cmd_install
}

cmd_self_update() {
  git -C "$root" pull --ff-only
  git -C "$root" submodule update
}

cmd_remove() {
  for l in "$bin/paseo" "$bin/tp"; do
    if ours "$l"; then rm -f "$l"; else echo "tp: left $l, not a turbopaseo link" >&2; fi
  done
  rm -rf "${opt:?}"
  echo "removed $opt"
}

cmd_status() {
  [ -L "$opt/current" ] || { echo "not installed in $prefix"; return 0; }
  echo "installed: $(readlink "$opt/current") in $opt"
  echo "paseo: $bin/paseo -> $(readlink "$bin/paseo" 2>/dev/null || echo missing)"
  echo "checkout: $root ($(git -C "$root" log -1 --format='%h %cs'))"
}

case ${1:-} in
  install) shift; cmd_install "$@" ;;
  rebuild) cmd_rebuild ;;
  update) cmd_self_update; exec "$self" rebuild ;;
  self-update) cmd_self_update ;;
  remove) cmd_remove ;;
  status) cmd_status ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
